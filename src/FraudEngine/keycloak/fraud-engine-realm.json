{
  "realm": "fraud-engine",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "fraud-analyst",
        "description": "Can view and search fraud alerts and watchlist entries"
      },
      {
        "name": "fraud-admin",
        "description": "Full access to fraud engine operations"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "fraud-engine-api-audience",
      "description": "Adds fraud-engine-api as an audience to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "fraud-engine-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fraud-engine-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "fraud-engine-api",
      "name": "Fraud Engine API",
      "description": "Backend API resource server",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "fraud-engine-api-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {},
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "fraud-engine-api-audience"
      ]
    },
    {
      "clientId": "fraud-engine-swagger",
      "name": "Fraud Engine Swagger UI",
      "description": "Public client for Swagger UI OAuth2 login",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "http://localhost:5001",
        "https://localhost:5001",
        "https://localhost:7001",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "fraud-engine-api-audience"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@fraud-engine.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "fraud-admin"
      ]
    }
  ]
}
